{
  "name": "rastreador-veiculos",
  "version": "0.1.0",
  "private": true,
  "description": "Rastreador de oportunidades em leilões e repasses de veículos",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "db:migrate": "node --experimental-sqlite packages/db/src/migrate.js",
    "fipe:sync": "node packages/fipe/src/sync.js",
    "scrape": "node apps/api/src/runner/scrape.js",
    "api": "node apps/api/src/server.js",
    "dev": "node apps/api/src/server.js",
    "start": "node packages/worker/src/index.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "playwright": "^1.65.1",
    "telegraf": "^4.16.3"
  }
}
