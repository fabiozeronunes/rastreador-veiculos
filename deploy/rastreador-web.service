[Unit]
Description=Rastreador Veiculos - Next.js dashboard (porta 3000)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fabionunes
Group=fabionunes
WorkingDirectory=/home/fabionunes/rastreador-veiculos/apps/api
Environment=NODE_ENV=development
Environment=PATH=/home/fabionunes/.nvm/versions/node/v22.23.5/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/fabionunes/.nvm/versions/node/v22.23.5/bin/node /home/fabionunes/rastreador-veiculos/node_modules/next/dist/bin/next dev --port 3000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
